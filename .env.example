# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Required. Create a key at https://console.groq.com/keys.
GROQ_API_KEY=
# Groq's free-tier general-purpose model. See https://console.groq.com/docs/models.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none

# Optional. Enables the Gemini fallback and the independent evaluation judge.
# Create a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

LOG_LEVEL=INFO
ENVIRONMENT=dev

# Retrieval configuration tuned via `python -m eval.run_eval retrieval`.
RETRIEVAL_DENSE_WEIGHT=1
RETRIEVAL_SPARSE_WEIGHT=1
RRF_K=10
RETRIEVAL_RERANK=false
EMBEDDING_QUERY_PREFIX=""

# Run the two research agents concurrently (requires headroom on the Groq rate limit).
AGENT_PARALLEL=false

# Refusal threshold on the top rerank score (used only when RETRIEVAL_RERANK=true).
# MIN_RERANK_SCORE=-5.0
